{
  "name": "@fern-ui/hooks",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/fern-api/fern-platform.git",
    "directory": "packages/commons/hooks"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.js"
    }
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "source": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf ./lib && tsc --build --clean",
    "compile": "tsc --build",
    "depcheck": "depcheck",
    "format": "prettier --write --ignore-unknown \"**\"",
    "format:check": "prettier --check --ignore-unknown \"**\"",
    "lint:eslint": "eslint --max-warnings 0 .",
    "lint:eslint:fix": "pnpm lint:eslint --fix",
    "lint:style": "stylelint 'src/**/*.scss' --allow-empty-input --max-warnings 0",
    "lint:style:fix": "pnpm lint:style --fix",
    "test": "vitest --run --passWithNoTests --globals"
  },
  "dependencies": {
    "@fern-api/docs-utils": "workspace:*",
    "@fern-api/fdr-sdk": "workspace:*",
    "@fern-api/ui-core-utils": "workspace:*",
    "@fern-platform/fdr-utils": "workspace:*",
    "@fern-ui/react-commons": "workspace:*",
    "@fern-ui/state": "workspace:*",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "es-toolkit": "^1.39.3",
    "next": "15.3.0-canary.1",
    "next-themes": "^0.4.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "swr": "^2.3.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@fern-api/fdr-sdk": "workspace:*",
    "@fern-platform/configs": "workspace:*",
    "@types/node": "^18.11.9",
    "@types/qs": "6.9.14",
    "depcheck": "^1.4.7",
    "qs": "^6.14.0",
    "stylelint": "^16.1.0",
    "typescript": "^5",
    "vitest": "^3.1.3"
  }
}
