{
    "$schema": "https://swc.rs/schema.json",
    "exclude": [".*\\.test\\.tsx?"],
    "env": {
        "exclude": ["transform-async-to-generator"]
    },
    "jsc": {
        "parser": {
            "decorators": true,
            "syntax": "typescript",
            "tsx": false
        },
        "transform": {
            "verbatimModuleSyntax": true
        }
    },
    "module": {
        "type": "es6"
    },
    "sourceMaps": true,
    "inlineSourcesContent": false
}
