{
  "name": "@fern-api/docs-loader",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/fern-api/fern-platform.git",
    "directory": "packages/commons/docs-loader"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/index.client.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf ./lib ./dist && tsc --build --clean",
    "compile": "pnpm compile:js && pnpm compile:types",
    "compile:js": "swc ./src --out-dir ./dist/js --copy-files --strip-leading-paths",
    "compile:types": "tsc -p . --emitDeclarationOnly --declaration --outDir ./dist/types",
    "depcheck": "depcheck",
    "format": "prettier --write --ignore-unknown \"**\"",
    "format:check": "prettier --check --ignore-unknown \"**\"",
    "lint:eslint": "eslint --max-warnings 0 .",
    "lint:eslint:fix": "pnpm lint:eslint --fix",
    "lint:style": "stylelint 'src/**/*.scss' --allow-empty-input --max-warnings 0",
    "lint:style:fix": "pnpm lint:style --fix",
    "test": "vitest --run --passWithNoTests --globals"
  },
  "dependencies": {
    "@fern-api/docs-auth": "workspace:*",
    "@fern-api/docs-server": "workspace:*",
    "@fern-api/docs-utils": "workspace:*",
    "@fern-api/fai-sdk": "workspace:*",
    "@fern-api/ui-core-utils": "workspace:*",
    "@fern-api/visual-editor-server": "workspace:*",
    "@fern-docs/edge-config": "workspace:*",
    "@types/react": "19.0.10",
    "@vercel/kv": "^2.0.0",
    "es-toolkit": "^1.33.0",
    "next": "catalog:",
    "react": "19.0.0",
    "ts-essentials": "^10.0.4"
  },
  "devDependencies": {
    "@fern-api/fdr-sdk": "workspace:*",
    "@fern-platform/configs": "workspace:*",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/node": "^22.0.0",
    "depcheck": "^1.4.7",
    "stylelint": "^16.1.0",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
