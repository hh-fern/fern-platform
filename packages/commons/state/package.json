{
  "name": "@fern-ui/state",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/fern-api/fern-platform.git",
    "directory": "packages/commons/state"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "source": "src/index.ts",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf ./lib && tsc --build --clean",
    "compile": "tsc --build",
    "depcheck": "depcheck",
    "format": "prettier --write --ignore-unknown \"**\"",
    "format:check": "prettier --check --ignore-unknown \"**\"",
    "lint:eslint": "eslint --max-warnings 0 .",
    "lint:eslint:fix": "pnpm lint:eslint --fix",
    "lint:style": "stylelint 'src/**/*.scss' --allow-empty-input --max-warnings 0",
    "lint:style:fix": "pnpm lint:style --fix",
    "test": "vitest --run --passWithNoTests --globals"
  },
  "dependencies": {
    "@fern-api/docs-auth": "workspace:*",
    "@fern-api/docs-utils": "workspace:*",
    "@fern-api/fdr-sdk": "workspace:*",
    "@fern-api/ui-core-utils": "workspace:*",
    "@fern-ui/react-commons": "workspace:*",
    "es-toolkit": "^1.39.3",
    "jotai": "^2.12.1",
    "launchdarkly-react-client-sdk": "^3.6.0",
    "react": "19.0.0",
    "ts-essentials": "^10.0.4",
    "use-memo-one": "^1.1.3",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@fern-platform/configs": "workspace:*",
    "@types/node": "^18.11.9",
    "@types/react": "19.0.10",
    "depcheck": "^1.4.7",
    "stylelint": "^16.1.0",
    "typescript": "^5",
    "vitest": "^3.0.5"
  },
  "compilerOptions": {
    "jsx": "react-jsx"
  }
}
