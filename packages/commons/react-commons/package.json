{
  "name": "@fern-ui/react-commons",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/fern-api/fern-platform.git",
    "directory": "packages/commons/react-commons"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/js/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "clean": "rm -rf ./lib ./dist && tsc --build --clean",
    "compile": "pnpm compile:js && pnpm compile:types",
    "compile:js": "swc ./src --out-dir ./dist/js --copy-files --strip-leading-paths",
    "compile:types": "tsc -p . --emitDeclarationOnly --declaration --outDir ./dist/types",
    "depcheck": "depcheck",
    "dev": "swc ./src --out-dir ./dist/js --copy-files --strip-leading-paths --watch",
    "format": "prettier --write --ignore-unknown \"**\"",
    "format:check": "prettier --check --ignore-unknown \"**\"",
    "lint:eslint": "eslint --max-warnings 0 .",
    "lint:eslint:fix": "pnpm lint:eslint --fix",
    "lint:style": "stylelint 'src/**/*.scss' --allow-empty-input --max-warnings 0",
    "lint:style:fix": "pnpm lint:style --fix",
    "test": "vitest --run --passWithNoTests --globals"
  },
  "dependencies": {
    "@fern-api/ui-core-utils": "workspace:*",
    "es-toolkit": "catalog:",
    "fastdom": "^1.0.12",
    "immer": "^9.0.15",
    "ts-essentials": "catalog:"
  },
  "devDependencies": {
    "@fern-platform/configs": "workspace:*",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "depcheck": "catalog:",
    "jotai": "catalog:",
    "react": "catalog:",
    "stylelint": "catalog:",
    "typescript": "catalog:",
    "vite": "^6.1.0",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "jotai": "^2",
    "react": "^19"
  }
}
