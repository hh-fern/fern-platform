{
  "name": "@fern-api/ui-core-utils",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/fern-api/fern-platform.git",
    "directory": "packages/commons/core-utils"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./assertNever": {
      "types": "./dist/types/assertNever.d.ts",
      "default": "./dist/js/assertNever.js"
    },
    "./titleCase": {
      "types": "./dist/types/titleCase.d.ts",
      "default": "./dist/js/titleCase.js"
    },
    "./unknownToString": {
      "types": "./dist/types/unknownToString.d.ts",
      "default": "./dist/js/unknownToString.js"
    },
    "./visitDiscriminatedUnion": {
      "types": "./dist/types/visitDiscriminatedUnion.d.ts",
      "default": "./dist/js/visitDiscriminatedUnion.js"
    },
    "./isPlainObject": {
      "types": "./dist/types/objects/isPlainObject.d.ts",
      "default": "./dist/js/objects/isPlainObject.js"
    },
    "./identity": {
      "types": "./dist/types/identity.d.ts",
      "default": "./dist/js/identity.js"
    },
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/js/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "clean": "rm -rf ./lib ./dist && tsc --build --clean",
    "compile": "pnpm compile:js && pnpm compile:types",
    "compile:js": "swc ./src --out-dir ./dist/js --copy-files --strip-leading-paths",
    "compile:types": "tsc -p . --emitDeclarationOnly --declaration --outDir ./dist/types",
    "depcheck": "depcheck",
    "dev": "swc ./src --out-dir ./dist/js --copy-files --strip-leading-paths --watch",
    "format": "prettier --write --ignore-unknown \"**\"",
    "format:check": "prettier --check --ignore-unknown \"**\"",
    "lint:eslint": "eslint --max-warnings 0 .",
    "lint:eslint:fix": "pnpm lint:eslint --fix",
    "lint:style": "stylelint 'src/**/*.scss' --allow-empty-input --max-warnings 0",
    "lint:style:fix": "pnpm lint:style --fix",
    "test": "vitest --run --passWithNoTests --globals"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "strip-ansi": "^7.1.0",
    "title": "^3.5.3",
    "ua-parser-js": "^1.0.35"
  },
  "devDependencies": {
    "@fern-platform/configs": "workspace:*",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "@types/title": "^3.4.3",
    "@types/ua-parser-js": "^0.7.39",
    "depcheck": "catalog:",
    "stylelint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
