{
  "name": "@fern-api/syntax-highlighter",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/fern-api/fern-platform.git",
    "directory": "packages/commons/syntax-highlighter"
  },
  "sideEffects": false,
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "source": "src/index.ts",
  "types": "src/index.ts",
  "files": ["dist"],
  "scripts": {
    "clean": "rm -rf ./lib ./dist && tsc --build --clean",
    "compile": "tsc --build",
    "depcheck": "depcheck",
    "format": "prettier --write --ignore-unknown \"**\"",
    "format:check": "prettier --check --ignore-unknown \"**\"",
    "lint:eslint": "eslint --max-warnings 0 .",
    "lint:eslint:fix": "pnpm lint:eslint --fix",
    "test": "vitest --run --passWithNoTests --globals"
  },
  "dependencies": {
    "es-toolkit": "catalog:",
    "hastscript": "catalog:",
    "shiki": "^3.2.1"
  },
  "devDependencies": {
    "@fern-platform/configs": "workspace:*",
    "@types/hast": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "depcheck": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vite": "^6.1.0",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19"
  }
}
