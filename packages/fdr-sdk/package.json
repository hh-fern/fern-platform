{
  "name": "@fern-api/fdr-sdk",
  "version": "0.0.0",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./cjs/index.cjs"
    },
    "./client/types": {
      "types": "./dist/client/types.d.ts",
      "import": "./dist/client/types.js",
      "require": "./cjs/client/types.cjs"
    },
    "./navigation": {
      "types": "./dist/navigation/index.d.ts",
      "import": "./dist/navigation/index.js",
      "require": "./cjs/navigation/index.cjs"
    },
    "./docs": {
      "types": "./dist/docs/index.d.ts",
      "import": "./dist/docs/index.js",
      "require": "./cjs/docs/index.cjs"
    },
    "./api-definition": {
      "types": "./dist/api-definition/index.d.ts",
      "import": "./dist/api-definition/index.js",
      "require": "./cjs/api-definition/index.cjs"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "require": "./cjs/client/index.cjs"
    },
    "./traversers": {
      "types": "./dist/utils/traversers/index.d.ts",
      "import": "./dist/utils/traversers/index.js",
      "require": "./cjs/utils/traversers/index.cjs"
    }
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "cjs"
  ],
  "scripts": {
    "build:tsup:cjs": "tsup --config tsup.config.ts --format cjs --out-dir cjs && tsc --project tsconfig.json --declaration --emitDeclarationOnly --outDir cjs",
    "build:tsup:esm": "tsup --config tsup.config.ts --format esm --out-dir dist && tsc --project tsconfig.json --declaration --emitDeclarationOnly --outDir dist",
    "clean": "rm -rf ./dist && tsc --build --clean",
    "compile": "tsc --build",
    "dev": "tsc --watch tsconfig.build.json",
    "format": "prettier --write --ignore-unknown \"**\"",
    "format:check": "prettier --check --ignore-unknown \"**\"",
    "lint": "eslint --max-warnings 0 src --ext .ts --resolve-plugins-relative-to ../../",
    "test": "vitest --run --passWithNoTests --globals",
    "test:update": "vitest --run  --passWithNoTests --globals -u"
  },
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@fern-api/snippets": "workspace:*",
    "@fern-api/ui-core-utils": "workspace:*",
    "@fern-platform/configs": "workspace:*",
    "@types/node-fetch": "2.6.9",
    "@types/qs": "6.9.14",
    "@types/tinycolor2": "^1.4.6",
    "@types/ungap__structured-clone": "^1.2.0",
    "@ungap/structured-clone": "^1.2.0",
    "dayjs": "^1.11.11",
    "es-toolkit": "^1.32.0",
    "escape-string-regexp": "^5.0.0",
    "fast-deep-equal": "^3.1.3",
    "form-data": "4.0.4",
    "httpsnippet-lite": "^3.0.5",
    "js-base64": "3.7.7",
    "node-fetch": "2.7.0",
    "qs": "6.12.0",
    "tinycolor2": "^1.6.0",
    "ts-essentials": "^10.0.4",
    "tsup": "^8.3.5",
    "typescript": "^5",
    "url-join": "5.0.0",
    "vitest": "^3.2.4"
  }
}
