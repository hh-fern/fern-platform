{
    "$schema": "https://swc.rs/schema.json",
    "exclude": [".*\\.test\\.tsx?"],
    "env": {
        "exclude": ["transform-async-to-generator"]
    },
    "jsc": {
        "parser": {
            "decorators": true,
            "syntax": "typescript",
            "tsx": true
        },
        "transform": {
            "verbatimModuleSyntax": true,
            "react": {
                "runtime": "automatic",
                "importSource": "react"
            }
        },
        "paths": {
            "@/*": ["./src/*"]
        },
        "baseUrl": ".",
        "experimental": {
            "plugins": [["@swc/plugin-styled-jsx", {}]]
        }
    },
    "module": {
        "type": "es6"
    },
    "sourceMaps": true,
    "inlineSourcesContent": false
}
