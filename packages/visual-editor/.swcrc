{
    "$schema": "https://swc.rs/schema.json",
    "exclude": [".*\\.test\\.tsx?"],
    "jsc": {
        "parser": {
            "decorators": true,
            "syntax": "typescript",
            "tsx": true
        },
        "transform": {
            "verbatimModuleSyntax": true
        },
        "paths": {
            "@/*": ["./src/*"]
        },
        "baseUrl": "."
    },
    "module": {
        "type": "es6"
    },
    "sourceMaps": true,
    "inlineSourcesContent": false
}
