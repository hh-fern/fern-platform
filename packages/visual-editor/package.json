{
  "name": "@fern-dashboard/visual-editor",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/fern-api/fern-platform.git",
    "directory": "packages/visual-editor"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./client/*": {
      "types": "./dist/types/client/*.d.ts",
      "default": "./dist/js/client/*.js"
    },
    "./server/*": {
      "types": "./dist/types/server/*.d.ts",
      "default": "./dist/js/server/*.js"
    },
    "./shared/*": {
      "types": "./dist/types/shared/*.d.ts",
      "default": "./dist/js/shared/*.js"
    },
    "./styles": {
      "default": "./src/client/styles.scss"
    }
  },
  "files": ["dist"],
  "scripts": {
    "clean": "rm -rf ./lib ./dist && tsc --build --clean",
    "compile": "pnpm compile:js && pnpm compile:types",
    "compile:js": "swc ./src --out-dir ./dist/js --copy-files --strip-leading-paths",
    "compile:types": "tsc -p . --emitDeclarationOnly --declaration --outDir ./dist/types",
    "depcheck": "depcheck",
    "dev": "swc ./src --out-dir ./dist/js --watch --copy-files --strip-leading-paths",
    "format": "prettier --write --ignore-unknown \"**\"",
    "format:check": "prettier --check --ignore-unknown \"**\"",
    "lint:eslint": "eslint --max-warnings 0 .",
    "lint:eslint:fix": "pnpm lint:eslint --fix",
    "lint:style": "stylelint 'src/**/*.scss' --allow-empty-input --max-warnings 0",
    "lint:style:fix": "pnpm lint:style --fix",
    "test": "vitest --run --passWithNoTests --globals"
  },
  "dependencies": {
    "@fern-api/docs-auth": "workspace:*",
    "@fern-api/docs-loader": "workspace:*",
    "@fern-api/docs-utils": "workspace:*",
    "@fern-api/endpoint-snippet-dependencies": "workspace:*",
    "@fern-api/fdr-sdk": "workspace:*",
    "@fern-api/ui-core-utils": "workspace:*",
    "@fern-dashboard/services": "workspace:*",
    "@fern-docs/components": "workspace:*",
    "@fern-docs/mdx": "workspace:*",
    "@fern-docs/search-ui": "workspace:*",
    "@fern-ui/react-commons": "workspace:*",
    "@floating-ui/react": "^0.27.16",
    "@heroicons/react": "^2.2.0",
    "@mdx-js/react": "^3.1.0",
    "@microlink/react-json-view": "^1.26.1",
    "@radix-ui/primitive": "catalog:",
    "@radix-ui/react-compose-refs": "catalog:",
    "@radix-ui/react-dialog": "catalog:",
    "@radix-ui/react-popover": "catalog:",
    "@radix-ui/react-select": "catalog:",
    "@radix-ui/react-slot": "catalog:",
    "@radix-ui/react-switch": "catalog:",
    "@radix-ui/react-tabs": "catalog:",
    "@radix-ui/react-tooltip": "catalog:",
    "@react-three/drei": "10.0.3",
    "@react-three/fiber": "9.0.4",
    "@sentry/nextjs": "^10.12.0",
    "@tiptap/core": "3.4.4",
    "@tiptap/extension-code-block": "^3.4.4",
    "@tiptap/extension-drag-handle": "^3.0.9",
    "@tiptap/extension-drag-handle-react": "^3.0.9",
    "@tiptap/extension-file-handler": "^3.4.1",
    "@tiptap/extension-placeholder": "^3.0.5",
    "@tiptap/pm": "3.4.4",
    "@tiptap/react": "3.4.4",
    "@tiptap/starter-kit": "3.4.4",
    "@tiptap/suggestion": "3.4.4",
    "class-variance-authority": "^0.7.1",
    "css-tree": "^3.1.0",
    "es-toolkit": "catalog:",
    "fastdom": "^1.0.12",
    "github-slugger": "^2.0.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.460.0",
    "mdx-bundler": "^10.1.1",
    "motion": "^12.4.7",
    "next-themes": "^0.4.4",
    "react-dom": "catalog:",
    "react-error-boundary": "^5.0.0",
    "react-hotkeys-hook": "^5.1.0",
    "react-medium-image-zoom": "^5.2.14",
    "server-only": "^0.0.1",
    "sonner": "^2.0.3",
    "three": "^0.173.0",
    "ts-essentials": "catalog:",
    "url-join": "catalog:",
    "zod": "catalog:",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@bprogress/next": "^3.2.11",
    "@fern-api/docs-server": "workspace:*",
    "@fern-platform/configs": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@swc/plugin-styled-jsx": "^9.1.0",
    "@testing-library/react": "^16.3.0",
    "@types/css-tree": "^2.3.10",
    "@types/hast": "^3.0.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/three": "^0.173.0",
    "depcheck": "catalog:",
    "jotai": "catalog:",
    "mermaid": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "sass": "^1.77.0",
    "styled-jsx": "^5.1.7",
    "stylelint": "catalog:",
    "typescript": "catalog:",
    "vite": "^6.1.0",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "jotai": "^2",
    "react": "^19"
  }
}
