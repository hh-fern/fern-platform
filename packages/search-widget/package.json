    "clean": "rm -rf .next dist .turbo"
  },
  "dependencies": {
    "@fern-docs/search-ui": "workspace:*",
    "@fern-docs/search-ask-fern": "workspace:*",
    "@fern-docs/search-keyword": "workspace:*",
    "@fern-docs/search-utils": "workspace:*",
    "@fern-docs/components": "workspace:*",
    "@fern-api/docs-server": "workspace:*",
    "@fern-api/ui-core-utils": "workspace:*",
    "@fern-api/fai-sdk": "workspace:*",
    "@fern-ui/react-commons": "workspace:*",
    "@ai-sdk/openai": "2.0.0-beta.2",
    "@ai-sdk/anthropic": "2.0.0-beta.2",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "ai": "5.0.0-beta.2",
    "algoliasearch": "^5.20.3",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^0.460.0",
    "next": "15.3.0-canary.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwindcss": "^4.0.9",
    "zod": "^3.25.49"
  },
  "devDependencies": {
    "@fern-platform/configs": "workspace:*",
