{
  "name": "@fern-platform/search-widget",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/components/SearchWidget.tsx",
    "./widget": "./dist/widget.js"
  },
  "scripts": {
    "build": "next build",
    "build:widget": "tsup src/components/SearchWidget.tsx --format esm,cjs --dts --external react --external react-dom",
    "dev": "next dev --port 3001",
    "start": "next start",
