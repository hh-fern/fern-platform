{
  "name": "@fern-dashboard/services",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/fern-api/fern-platform.git",
    "directory": "packages/fern-dashboard-services"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./auth/*": {
      "types": "./dist/types/auth/*.d.ts",
      "default": "./dist/js/auth/*.js"
    },
    "./redis/*": {
      "types": "./dist/types/redis/*.d.ts",
      "default": "./dist/js/redis/*.js"
    },
    "./utils/*": {
      "types": "./dist/types/utils/*.d.ts",
      "default": "./dist/js/utils/*.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "clean": "rm -rf ./lib ./dist && tsc --build --clean",
    "compile": "pnpm compile:js && pnpm compile:types",
    "compile:js": "swc ./src --out-dir ./dist/js --copy-files --strip-leading-paths",
    "compile:types": "tsc -p . --emitDeclarationOnly --declaration --outDir ./dist/types",
    "depcheck": "depcheck",
    "format": "prettier --write --ignore-unknown \"**\"",
    "format:check": "prettier --check --ignore-unknown \"**\"",
    "lint:eslint": "eslint --max-warnings 0 .",
    "lint:eslint:fix": "pnpm lint:eslint --fix",
    "lint:style": "stylelint 'src/**/*.scss' --allow-empty-input --max-warnings 0",
    "lint:style:fix": "pnpm lint:style --fix",
    "test": "vitest --run --passWithNoTests --globals"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.6.1",
    "@octokit/auth-app": "^8.1.0",
    "@octokit/core": "^7.0.4",
    "@upstash/redis": "^1.34.6",
    "auth0": "^4.20.0",
    "jsonwebtoken": "^9.0.2",
    "next": "catalog:",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@fern-platform/configs": "workspace:*",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "catalog:",
    "depcheck": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
