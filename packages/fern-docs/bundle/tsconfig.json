{
  "extends": "@fern-platform/configs/tsconfig/nextjs.json",
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "strictNullChecks": true,
    "jsx": "preserve"
  },
  "exclude": ["node_modules", "**/__snapshots__"],
  "include": ["src/**/*", ".next/types/**/*.ts", ".storybook/**/*.{ts,tsx}", "next.config.ts", "vitest.config.ts"]
}
