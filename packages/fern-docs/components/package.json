  "bugs": {
    "url": "https://github.com/fern-api/fern-platform/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fern-api/fern-platform.git",
    "directory": "packages/components"
  },
  "sideEffects": ["*.css", "*.scss"],
  "type": "module",
  "exports": {
    "./index.css": "./dist/js/index.css",
    "./badges": {
      "types": "./dist/types/badges/index.d.ts",
      "default": "./dist/js/badges/index.js"
    },
    "./button": {
      "types": "./dist/types/FernButtonV2.d.ts",
      "default": "./dist/js/FernButtonV2.js"
    },
    "./kbd": {
      "types": "./dist/types/kbd.d.ts",
      "default": "./dist/js/kbd.js"
    },
    "./colors.css": "./dist/js/colors.css",
    "./fern-accent.scss": "./dist/js/fern-accent.scss",
    "./badges/index.scss": "./dist/js/badges/index.scss",
    "./kbd.css": "./dist/js/kbd.css",
    "./util/fa": {
      "types": "./dist/types/util/fa.d.ts",
      "default": "./dist/js/util/fa.js"
    },
    "./syntax-highlighter": {
      "types": "./dist/types/syntax-highlighter/index.d.ts",
      "default": "./dist/js/syntax-highlighter/index.js"
    },
    "./syntax-highlighter/index.css": "./dist/js/syntax-highlighter/index.css",
    "./styles": "./dist/js/index.css",
    "./*": {
      "types": "./dist/types/*.d.ts",
      "default": "./dist/js/*.js"
    },
    "./layouts": {
      "types": "./dist/types/layouts/index.d.ts",
      "default": "./dist/js/layouts/index.js"
    },
    "./navigation/local-storage": {
      "types": "./dist/types/navigation/localStorageUtils.d.ts",
      "default": "./dist/js/navigation/localStorageUtils.js"
    }
  },
  "files": ["src"],
  "scripts": {
    "build-storybook": "storybook build",
    "chromatic": "pnpx chromatic --project-token=chpt_48b3c560025e978",
    "clean": "rm -rf ./lib ./dist && tsc --build --clean",
    "compile": "pnpm compile:js && pnpm compile:types",
    "compile:js": "swc ./src --out-dir ./dist/js --copy-files --strip-leading-paths",
    "compile:types": "tsc -p . --emitDeclarationOnly --declaration --outDir ./dist/types",
    "depcheck": "depcheck",
    "dev": "swc ./src --out-dir ./dist/js --copy-files --strip-leading-paths --watch",
    "format": "prettier --write --ignore-unknown \"**\"",
    "format:check": "prettier --check --ignore-unknown \"**\"",
    "lint:eslint": "eslint --max-warnings 0 .",
    "lint:eslint:fix": "pnpm lint:eslint --fix",
    "lint:style": "stylelint 'src/**/*.scss' --allow-empty-input --max-warnings 0",
    "lint:style:fix": "pnpm lint:style --fix",
    "storybook": "storybook dev -p 6006",
    "test": "vitest --run --passWithNoTests --globals --disable-console-intercept"
  },
  "eslintConfig": {
    "extends": ["plugin:storybook/recommended"]
  },
