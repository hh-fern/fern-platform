{
  "extends": "@fern-platform/configs/tsconfig/nextjs.json",
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node", "next", "vitest/globals"],
    "strictNullChecks": true,
    "skipLibCheck": true,
    "plugins": [{ "name": "next" }]
  },
  "exclude": ["node_modules", "../fern-docs/search-ui/**/*", "**/node_modules/**/*"],
  "include": ["next.config.ts", ".next/types/**/*.ts", "src/**/*", "vitest.config.ts", "sentry.*.config.ts"]
}
