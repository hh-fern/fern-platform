{
  "name": "@fern-dashboard/ui",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/fern-api/fern-platform.git",
    "directory": "packages/fern-dashboard"
  },
  "type": "module",
  "scripts": {
    "clean": "rm -rf ./.next",
    "dashboard:build": "next build",
    "dashboard:dev": "next dev",
    "dashboard:dev:inspect": "NODE_OPTIONS='--inspect' next dev",
    "dashboard:dev:turbopack": "next dev --turbopack",
    "dashboard:lint": "next lint",
    "dashboard:rsd": "RSD=1 NODE_OPTIONS='--max-old-space-size=8192' next build",
    "dashboard:rsd:client": "rsdoctor analyze --profile .next/.rsdoctor/manifest.json",
    "dashboard:rsd:server": "rsdoctor analyze --profile .next/server/.rsdoctor/manifest.json",
    "dashboard:start": "next start",
    "db:migrate:dev": "dotenv -e .env.dev -- prisma migrate deploy --schema server/prisma/schema.prisma",
    "db:migrate:local": "dotenv -e .env.local -- prisma migrate deploy --schema server/prisma/schema.prisma",
    "db:migrate:prod": "dotenv -e .env.prod -- prisma migrate deploy --schema server/prisma/schema.prisma",
    "depcheck": "depcheck",
    "format": "prettier --write --ignore-unknown \"**\"",
    "format:check": "prettier --check --ignore-unknown \"**\"",
    "lint": "pnpm lint:eslint && pnpm lint:style",
    "lint:eslint": "eslint --max-warnings 0 . --ignore-pattern .next --ignore-pattern '**/*.{m,c,}js'",
    "lint:eslint:fix": "pnpm lint:eslint --fix",
    "lint:style": "stylelint 'src/**/*.scss' --allow-empty-input --max-warnings 0",
    "lint:style:fix": "pnpm lint:style --fix",
    "test": "vitest --run --passWithNoTests --globals",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.54.0",
    "@auth0/nextjs-auth0": "^4.6.1",
    "@aws-sdk/client-s3": "^3.744.0",
    "@aws-sdk/s3-request-presigner": "^3.744.0",
    "@bprogress/next": "^3.2.11",
    "@fern-api/docs-loader": "workspace:*",
    "@fern-api/docs-server": "workspace:*",
    "@fern-api/docs-utils": "workspace:*",
    "@fern-api/fai-sdk": "workspace:*",
    "@fern-api/fdr-sdk": "workspace:*",
    "@fern-api/venus-api-sdk": "^0.13.4-7-g5ff8ee8",
    "@fern-api/visual-editor-server": "workspace:*",
    "@fern-dashboard/services": "workspace:*",
    "@fern-dashboard/visual-editor": "workspace:*",
    "@fern-docs/components": "workspace:*",
    "@fern-docs/edge-config": "workspace:*",
    "@fern-docs/mdx": "workspace:*",
    "@fern-docs/search-ui": "workspace:*",
    "@fern-ui/loadable": "workspace:*",
    "@floating-ui/react": "^0.27.16",
    "@heroicons/react": "^2.2.0",
    "@monaco-editor/react": "^4.7.0",
    "@octokit/core": "^7.0.4",
    "@radix-ui/react-dialog": "catalog:",
    "@radix-ui/react-dropdown-menu": "catalog:",
    "@radix-ui/react-popover": "catalog:",
    "@radix-ui/react-select": "catalog:",
    "@radix-ui/react-slot": "catalog:",
    "@radix-ui/react-switch": "catalog:",
    "@radix-ui/react-tabs": "catalog:",
    "@sentry/nextjs": "^10.12.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/react-query": "^5.71.1",
    "@tanstack/react-query-devtools": "^5.71.1",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "auth0": "^4.20.0",
    "aws4": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.18",
    "jotai": "catalog:",
    "js-yaml": "catalog:",
    "lucide-react": "^0.460.0",
    "next": "catalog:",
    "next-themes": "^0.4.4",
    "posthog-js": "^1.258.2",
    "posthog-node": "^4.5.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "recharts": "^2.15.4",
    "server-only": "^0.0.1",
    "sharp": "^0.33.5",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@fern-platform/configs": "workspace:*",
    "@rsdoctor/cli": "^1.2.3",
    "@rsdoctor/rspack-plugin": "^1.2.3",
    "@rspack/core": "^1.2.3",
    "@sparticuz/chromium": "^133.0.0",
    "@tailwindcss/postcss": "^4.0.9",
    "@tailwindcss/typography": "^0.5.16",
    "@types/js-yaml": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^6.0.0",
    "glslify-import": "^3.1.0",
    "glslify-loader": "^2.0.0",
    "monaco-editor": "0.53.0",
    "next-rspack": "^15.5.3",
    "prisma": "5.13.0",
    "puppeteer-core": "^24.4.0",
    "raw-loader": "^4.0.2",
    "sass": "^1.77.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "webpack": "catalog:"
  }
}
