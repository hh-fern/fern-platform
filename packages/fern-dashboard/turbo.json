{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "globalEnv": [],
  "tasks": {
    "build": {
      "env": [
        "NEXT_RUNTIME",
        "SENTRY_AUTH_TOKEN",
        "VERCEL_ACCESS_TOKEN",
        "VERCEL_PROJECT_ID",
        "VERCEL_TEAM_ID"
      ]
    },
    "compile": {
      "outputs": ["tsconfig.tsbuildinfo"],
      "dependsOn": ["^build", "^compile", "codegen"],
      "env": ["FERN_SUPPORT_GITHUB_TOKEN"]
    },
    "dashboard:build": {
      "dependsOn": ["compile"],
      "outputs": [".next/**", "!.next/cache/**"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": [
        "SENTRY_AUTH_TOKEN",
        "VERCEL_ACCESS_TOKEN",
        "VERCEL_PROJECT_ID",
        "VERCEL_TEAM_ID"
      ]
    },
    "dashboard:dev": {
      "dependsOn": ["^build", "^compile"],
      "env": ["VERCEL_ACCESS_TOKEN", "VERCEL_PROJECT_ID", "VERCEL_TEAM_ID"]
    },
    "dashboard:start": {
      "dependsOn": ["dashboard:build"]
    },
    "dashboard:lint": {
      "dependsOn": ["^build", "^compile"]
    }
  }
}
